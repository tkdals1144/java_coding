package divideAndConquer;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.StringTokenizer;

public class B6549 {
	static long[] height;
	// 왼쪽 끝 left, 오른쪽 끝 right
	static long solve(int left, int right) {
		// 막대가 하나인 경우
		if (left == right) return height[left];
		
		int mid = (left + right) / 2;
		
		// 왼쪽과 오른쪽 구간의 최대값을 먼저 확인 (분할작업)
		long max = Math.max(solve(left, mid), solve(mid + 1, right));
		
		// 중앙을 가로지르는 경우는 어떠한가?
		int l = mid;
		int r = mid + 1;
		
		// 가운데 두개만 일단 확인
		long temp = Math.min(height[l], height[r]);
		max = Math.max(max, temp * 2);
		
		// 중앙으로부터 양쪽으로 확장 시도
		while (left < l || r < right) {
			
			// 오른쪽이 더 크다면 오른쪽으로 확장
			if (r < right && (l == left || height[l-1] < height[r+1])) {
				r++;
				temp = Math.min(temp, height[r]);
			}
			// 아니라면 왼쪽으로 확장한다
			else {
				l--;
				temp = Math.min(temp, height[l]);
			}
			max = Math.max(max, temp * (r - l + 1));
		}
		
		return max;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		while (true) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			int n = Integer.parseInt(st.nextToken());
			if (n == 0) break;
			height = new long[n];
			for (int i = 0; i < n; i++) {
				height[i] = Long.parseLong(st.nextToken());
			}
			sb.append(solve(0, n-1));
		}
		System.out.println(sb.toString());
	}
}
