package dijkstra;
import java.util.*;
import java.io.*;
public class B10282 {
	static final int INF = Integer.MAX_VALUE;
	static class Node {
		int to;
		int cost;
		public Node(int to, int cost) {
			super();
			this.to = to;
			this.cost = cost;
		}
	}
	static StringBuilder sb = new StringBuilder();
	// n : 컴퓨터 개수, d : 의존성 개수, c : 컴퓨터 번호
	static int n, d, c;
	static ArrayList<Node>[] arr;
	static int[] dist;
	static void reset() {
		arr = new ArrayList[n+1];
		for (int i = 0; i < arr.length; i++) {
			arr[i] = new ArrayList<>();
		}
		dist = new int[n+1];
		Arrays.fill(dist, INF);
	}
	static void dijkstra() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.cost - b.cost;
		});
		pq.offer(new Node(c, 0));
		dist[c] = 0;
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			if (now.cost > dist[now.to]) continue;
			for (Node next : arr[now.to]) {
				if (dist[next.to] > now.cost + next.cost) {
					dist[next.to] = now.cost + next.cost;
					pq.offer(new Node(next.to, dist[next.to]));
				}
			}
		}
		int count = 0;
		int max = 0;
		for (int i = 1; i <= n; i++) {
			if (dist[i] == INF) continue;
			count++;
			max = Math.max(max, dist[i]);
		}
		sb.append(count + " " + max).append('\n');
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int T = Integer.parseInt(br.readLine());
		for (int i = 0; i < T; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			n = Integer.parseInt(st.nextToken());
			d = Integer.parseInt(st.nextToken());
			c = Integer.parseInt(st.nextToken());
			reset();
			for (int j = 0; j < d; j++) {
				st = new StringTokenizer(br.readLine());
				int a = Integer.parseInt(st.nextToken());
				int b = Integer.parseInt(st.nextToken());
				int s = Integer.parseInt(st.nextToken());
				arr[a].add(new Node(b, s));
				arr[b].add(new Node(a, s));
			}
			dijkstra();
		}
		System.out.println(sb.toString());
	}
}
