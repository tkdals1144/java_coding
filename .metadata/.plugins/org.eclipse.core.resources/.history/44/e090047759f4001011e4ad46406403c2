	static boolean isSame(int x, int y, int size) {
		if (size == 1) return true;
		for (int i = x; i < x+size; i++) {
			for (int j = y; j < y+size; j++) {
				if (graph[i][j] != graph[x][y]) return false;
			}
		}
		return true;
	}
	public static void main(String[] args) throws IOException {
