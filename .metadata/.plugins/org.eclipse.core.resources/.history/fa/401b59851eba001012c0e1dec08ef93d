package bfs;
import java.util.*;
import java.io.*;

public class B16236 {
	static int N;
	static int[] dx = {0, -1, 1, 0};
	static int[] dy = {-1, 0, 0, 1};
	static int[][] graph;
	static int[][] dist;
	// 아기상어의 위치 y, x 순
	static int[] location = new int[2];
	// 아기상어의 크기
	static int size = 2;
	// 먹은 물고기의 수
	static int feed = 0;
	// break코드
	static boolean breakcode = true;
	
	static int bfs() {
		dist = new int[N][N];
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < N; j++) {
				dist[i][j] = -1;
			}
		}
		boolean check = false;
		// 뭘 넣어야 할까? -> dx, dy
		Deque<int[]> deque = new ArrayDeque<>();
		List<int[]> arr = new ArrayList<>();
		// x, y 순으로 부여할것!
		deque.offerLast(new int[] {location[0], location[1]});
		dist[location[0]][location[1]] = 0;
		while (!deque.isEmpty()) {
			int[] yx = deque.pollFirst();
			for (int i = 0; i < 4; i++) {
				int nx = yx[1] + dx[i];
				int ny = yx[0] + dy[i];
				// 방문하지 않았고, 사이즈가 작거나 같다면
				if (0 <= nx && 0 <= ny && nx < N && ny < N && dist[ny][nx] == -1 && graph[ny][nx] <= size) {
					dist[ny][nx] = dist[yx[0]][yx[1]] + 1;
					if (graph[ny][nx] == size || graph[ny][nx] == 0) {
						deque.offerLast(new int[] {ny, nx});
					} else {
						arr.add(new int[] {ny, nx});
						check = true;
//						graph[ny][nx] = 0;
//						return dist[ny][nx];
					}
				}
			}
		}
		Collections.sort(arr, (a, b) -> {
			if (a[0] != b[0]) {
				return a[0] - b[0];
			} else {
				return b[1] - a[1];
			}
		});
		if (check) {
			// 가장 먼저 아기상어 위치를 재할당
			location[0] = arr.get(0)[0];
			location[1] = arr.get(0)[1];
			// 아기상어가 먹은 물고기의 수를 체크
			feed++;
			// 만약 먹은 개수가 현재 크기랑 같다면
			if (feed == size) {
				feed = 0;
				size++;
			}
			graph[location[0]][location[1]] = 0;
			return dist[location[0]][location[1]];
		}
		breakcode = false;
		return 0;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		graph = new int[N][N];
		int count = 0;
		for (int i = 0; i < N; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			for (int j = 0; j < N; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
				if (graph[i][j] == 9) {
					location[0] = i;
					location[1] = j;
					graph[i][j] = 0;
				}
			}
		}
		while (breakcode) {
			int n = bfs();
			count += n;
		}
		System.out.println(count);
	}
}
