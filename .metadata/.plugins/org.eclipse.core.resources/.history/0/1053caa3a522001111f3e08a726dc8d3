package dijkstra;
import java.io.*;
import java.util.*;
public class B2665 {
	static class Node {
		int x, y;
		int cost;
		public Node(int x, int y, int cost) {
			super();
			this.x = x;
			this.y = y;
			this.cost = cost;
		}
	}
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	static int n;
	static int[][] dist;
	static int[][] graph;
	static void reset() {
		dist = new int[n][n];
		graph = new int[n][n];
		for (int i = 0; i < n; i++) {
			Arrays.fill(dist[i], Integer.MAX_VALUE);
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		n = Integer.parseInt(br.readLine());
		for (int i = 0; i < n; i++) {
			char[] input = br.readLine().toCharArray();
			for (int j = 0; j < n; j++) {
				if (input[i] == '0') graph[i][j] = 0;
				else graph[i][j] = 1;
			}
		}
	}
}
