package greedy;
import java.io.*;
import java.util.*;
public class B9241 {
	static int start = 0;
	static int end = 0;
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		char[] input1 = br.readLine().toCharArray();
		char[] input2 = br.readLine().toCharArray();
		int minLength = Math.min(input1.length, input2.length);
		for (int i = 0; i < minLength; i++) {
			if (input1[i] != input2[i]) {
				start = i;
				break;
			}
		}
		for (int i = 0; i < minLength; i++) {
			if (input1[input1.length-i-1] != input2[input2.length-i-1]) {
				end = input2.length-i;
				break;
			}
		}
		if ((end - start) == 0) {
			System.out.println(input2.length - input1.length);
		}
		System.out.println(end - start);
	}
}
