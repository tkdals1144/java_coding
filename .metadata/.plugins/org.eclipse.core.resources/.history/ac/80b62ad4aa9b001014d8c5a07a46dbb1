package Studying;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class B1463 {
	public static void main(String[] args) throws IOException {
		BufferedReader bf = new BufferedReader(new InputStreamReader(System.in));
		
		int N = Integer.parseInt(bf.readLine());
		int[] dp = new int [N+1];
		dp[2] = 1;
		dp[3] = 1;
		for (int i = 4; i <= N; i++) {
			// 둘 다 나누어 떨어지지 않음
			if (i % 2 != 0 && i % 3 != 0) {
				dp[i] = dp[i-1] + 1;
			}
			// 2로는 나누어 떨어지지만, 3은 아님
			else if (i % 2 == 0 && i % 3 != 0) {
				// 2로 나누는것과 -1 연산을 비교
				if (dp[i-1] > dp[i/2]) {
					dp[i] = dp[i/2] + 1;
				} else {
					dp[i] = dp[i-1] + 1;
				}
			}
			// 3으로는 나누어 떨어지지만, 2는 아님
			else if (i % 2 != 0 && i % 3 == 0) {
				// 3로 나누는것과 -1 연산을 비교
				if (dp[i-1] > dp[i/3]) {
					dp[i] = dp[i/3] + 1;
				} else {
					dp[i] = dp[i-1] + 1;
				}
			}
			// 2로도 3으로도 나누어 떨어지면 전부 비교
			else {
				if (dp[i-1] < dp[i/2] && dp[i-1] < dp[i/3]) {
					dp[i] = dp[i-1] + 1;
				} else if (dp[i/2] < dp[i-1] && dp[i/2] < dp[i/3]) {
					dp[i] = dp[i/2] + 1;
				} else {
					dp[i] = dp[i/3] + 1;
				}
			}
		}
		
		System.out.println(dp[N]);
	}
}