package dijkstra;
import java.io.*;
import java.util.*;
public class B4485 {
	static class Node {
		int x, y;
		int cost;
		public Node(int x, int y, int cost) {
			super();
			this.x = x;
			this.y = y;
			this.cost = cost;
		}
	}
	static int index = 1;
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	static StringBuilder sb = new StringBuilder();
	static int N;
	static int[][] dist;
	static int[][] graph;
	static void reset() {
		dist = new int[N][N];
		for (int i = 0; i < N; i++) {
			Arrays.fill(dist[i], Integer.MAX_VALUE);
		}
		graph = new int[N][N];
	}
	static void dijkstra() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.cost-b.cost;
		});
		pq.offer(new Node(0, 0, graph[0][0]));
		dist[0][0] = graph[0][0];
		while(!pq.isEmpty()) {
			Node now = pq.poll();
//			if (now.cost > graph[now.y][now.x]) continue;
			for (int i = 0; i < 4; i++) {
				int nx = now.x + dx[i];
				int ny = now.y + dy[i];
				if (check(nx, ny)) {
					if (dist[ny][nx] > now.cost + graph[ny][nx]) {
						dist[ny][nx] = now.cost + graph[ny][nx];
						pq.offer(new Node(nx, ny, dist[ny][nx]));
					}
				}
			}
		}
	}
	static boolean check(int x, int y) {
		return x >= 0 && y >= 0 && x < N && y < N;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		while (true) {
			N = Integer.parseInt(br.readLine());
			if (N == 0) break;
			reset();
			for (int i = 0; i < N; i++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				for (int j = 0; j < N; j++) {
					graph[i][j] = Integer.parseInt(st.nextToken());
				}
			}
			dijkstra();
			sb.append("Problem ").append(index++).append(": ").append(dist[N-1][N-1]).append('\n');
		}
		System.out.println(sb.toString());
	}
}
