package Studying;
import java.util.*;
import java.io.*;
public class B34052 {
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int sum = 0;
		for (int i = 0; i < 4; i++) {
			sum += Integer.parseInt(br.readLine());
		}
		if (sum <= 1500) {
			System.out.println("Yes");
			System.out.println("No");
		}
	}
}
