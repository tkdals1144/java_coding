package dijkstra;
import java.io.*;
import java.util.*;
public class B2665 {
	static class Node {
		int x, y;
		int cost;
		public Node(int x, int y, int cost) {
			super();
			this.x = x;
			this.y = y;
			this.cost = cost;
		}
	}
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	static int n;
	static int[][] dist;
	static int[][] graph;
	static void reset() {
		dist = new int[n][n];
		graph = new int[n][n];
		for (int i = 0; i < n; i++) {
			Arrays.fill(dist[i], Integer.MAX_VALUE);
		}
	}
	static void dijkstra() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.cost - b.cost;
		});
		pq.offer(new Node(0, 0, 0));
		dist[0][0] = 0;
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			if (now.cost > dist[now.y][now.x]) continue;
			for (int i = 0; i < 4; i++) {
				int nx = now.x + dx[i];
				int ny = now.y + dy[i];
				if (nx >= 0 && ny >= 0 && nx < n && ny < n) {
					if (graph[ny][nx] == 0 && dist[ny][nx] > now.cost + 1) {
						dist[ny][nx] = now.cost + 1;
						System.out.println("x : " + nx);
						System.out.println("y : " + ny);
						pq.offer(new Node(nx, ny, dist[ny][nx]));
					} else {
						if (dist[ny][nx] > now.cost) {
							dist[ny][nx] = now.cost;
							pq.offer(new Node(nx, ny, dist[ny][nx]));
						}
					}
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		n = Integer.parseInt(br.readLine());
		reset();
		for (int i = 0; i < n; i++) {
			char[] input = br.readLine().toCharArray();
			for (int j = 0; j < n; j++) {
				if (input[j] == '0') graph[i][j] = 0;
				else graph[i][j] = 1;
			}
		}
		dijkstra();
		System.out.println(dist[n-1][n-1]);
	}
}
