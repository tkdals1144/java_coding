package divideAndConquer;
import java.util.*;
import java.io.*;
public class B2630 {
	static int N;
	static int[][] graph;
	static int countWhite = 0;
	static int countBlue = 0;
	static void divide(int i, int j, int size) {
		if (isSame(i, j, size)) {
			if (graph[i][j] == 0) {
				countWhite++;
			} else countBlue++;
			return;
		}
		
		int half = size / 2;
		divide(i, j, half);
		divide(i, j+half, half);
		divide(i+half, j, half);
		divide(i+half, j+half, half);
	}
	static boolean isSame(int i, int j, int size) {
		
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		graph = new int[N][N];
		for (int i = 0; i < N; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			for (int j = 0; j < N; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
			}
		}
		divide(0, 0, N);
	}
}
