package Studying;
import java.io.*;
import java.util.*;

public class B1325 {
    static int N, M;
    static ArrayList<Integer>[] graph;
    static int[] dp;
    static int[] visited; // 0: 미방문, 1: 방문 중, 2: 완료
    
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        StringBuilder sb = new StringBuilder();

        N = Integer.parseInt(st.nextToken());
        M = Integer.parseInt(st.nextToken());

        graph = new ArrayList[N + 1];
        dp = new int[N + 1];
        visited = new int[N + 1];

        for (int i = 1; i <= N; i++) graph[i] = new ArrayList<>();

        for (int i = 0; i < M; i++) {
            st = new StringTokenizer(br.readLine());
            int a = Integer.parseInt(st.nextToken());
            int b = Integer.parseInt(st.nextToken());
            graph[b].add(a); // 역방향 저장
        }

        // 모든 노드에서 DFS 수행
        for (int i = 1; i <= N; i++) {
            if (visited[i] == 0) dfs(i);
        }

        int max = 0;
        for (int i = 1; i <= N; i++) max = Math.max(max, dp[i]);

        for (int i = 1; i <= N; i++) {
            if (dp[i] == max) sb.append(i).append(' ');
        }

        System.out.println(sb.toString().trim());
    }

    static int dfs(int node) {
        if (visited[node] == 2) return dp[node]; // 이미 계산 완료
        if (visited[node] == 1) return 0;       // 사이클 감지 시, 추가 count 안함

        visited[node] = 1;
        int count = 1; // 자신 포함

        for (int nxt : graph[node]) {
            count += dfs(nxt); // 재귀적으로 도달 가능한 노드 수 누적
        }

        dp[node] = count;
        visited[node] = 2; // 완료 표시
        return dp[node];
    }
}