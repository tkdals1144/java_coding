package backTracking;
import java.io.*;
import java.util.*;

public class B9663 {
	static int N;
	static int count = 0;
	// 세로방향, 대각선 두개
	static boolean[] visited0, visited1, visited2, visited3;
	
	// 3 2 1 0     0 1 2 3
	// 4 3 2 1     1 2 3 4
	// 5 4 3 2     2 3 4 5
	// 6 5 4 3     3 4 5 6
	
	static void dfs(int depth) {
		if (depth == N) {
			count++;
			return;
		}
		// y축 값 i
		for (int i = 0; i < N; i++) {
			// x축 값 j
			for (int j = 0; j < N; j++) {
				if (visited0[j] || visited1[i] || visited2[i+j] || visited3[N-1-j+i]) continue;
				visited0[j] = true;
				visited1[i] = true;
				visited2[i+j] = true;
				visited3[N-1-j+1] = true;
				dfs(depth+1);
				visited0[j] = false;
				visited1[i] = false;
				visited2[i+j] = false;
				visited3[N-1-j+1] = false;
			}
		}
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		visited0 = new boolean[N];
		visited1 = new boolean[N];
		visited2 = new boolean[2*N-1];
		visited3 = new boolean[2*N-1];
		dfs(0);
		System.out.println(count);
	}
}
