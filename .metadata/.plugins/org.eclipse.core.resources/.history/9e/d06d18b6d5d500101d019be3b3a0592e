package dp;
import java.util.*;
import java.io.*;

public class B10844 {
	static int N;
	static int[] arr;
	static StringBuilder sb = new StringBuilder();
	static int count = 0;
	static void dfs(int depth) {
		if (depth == N) {
			for (int i : arr) {
				sb.append(i + " ");
			}
			sb.append('\n');
			count++;
			return;
		}
		for (int i = 0; i <= 9; i++) {
			if (depth == 0) {
				if (i == 0) continue;
				arr[depth] = i;
				dfs(depth+1);
			} else {
				if (i == arr[depth-1] - 1 || i == arr[depth-1] + 1) {
					arr[depth] = i;
					dfs(depth+1);
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		arr = new int[N];
		dfs(0);
		System.out.println(sb.toString());
		System.out.println(count);
		// 1 -> 9
		// 2 -> 17  (9 *  2) - 1
		// 3 -> 32  (17 * 2) - 2
		// 4 -> 61  (32 * 2) - 3
		// 5 -> 116 (61 * 2) - 6
		// 6 -> 222 (116 * 2) - 10
		// 7 -> 
	}
}
