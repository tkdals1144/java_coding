package dijkstra;
import java.util.*;
import java.io.*;
public class B1238 {
	// N명, M개의 길, 개최지 X
	static int N, M, X;
	static int max = 0;
	// [{ <num2, dist2>, <num3, dist3> }, { <num1, dist1>, <num3, dist3> }]
	// 즉 다른곳들로부터 X로 그리고 X로부터 다른곳들로의 합을 구해야 한다.
	// 그러니 dist가 두개 필요하다
	static ArrayList<Node>[] arr;
	static int[] dist;
	static int[] dist2;
	static class Node {
		int num;
		int dist;
		public Node(int num, int dist) {
			super();
			this.num = num;
			this.dist = dist;
		}
	}
	static void func() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.dist - b.dist;
		});
		// 일단 시작점을 넣어
		pq.offer(new Node(X, 0));
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			// 만약 해당 위치로의 길이가 이미 저장된 길이보다 길다면 연산 가치가 없음
			if (now.dist > dist[now.num]) continue;
			for (Node next : arr[now.num]) {
				if (dist[next.num] > now.dist + next.dist) {
					dist[next.num] = now.dist + next.dist;
					pq.offer(new Node(next.num, dist[next.num]));
					max = Math.max(max, dist[next.num]);
				}
			}
		}
	}
	static void func2(int start) {
		if (start == X) {
			dist2[X] = 0;
			return;
		}
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.dist - b.dist;
		});
		// 일단 시작점을 넣어
		pq.offer(new Node(X, 0));
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			// 만약 해당 위치로의 길이가 이미 저장된 길이보다 길다면 연산 가치가 없음
			if (now.dist > dist[now.num]) continue;
			for (Node next : arr[now.num]) {
				if (dist[next.num] > now.dist + next.dist) {
					dist[next.num] = now.dist + next.dist;
					pq.offer(new Node(next.num, dist[next.num]));
					max = Math.max(max, dist[next.num]);
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		X = Integer.parseInt(st.nextToken());

		arr = new ArrayList[N+1];
		for (int i = 1; i < arr.length; i++) {
			arr[i] = new ArrayList<>();
		}
		dist = new int[N+1];
		Arrays.fill(dist, Integer.MAX_VALUE);
		dist[X] = 0;
		for (int i = 0; i < M; i++) {
			st = new StringTokenizer(br.readLine());
			int start = Integer.parseInt(st.nextToken());
			int end = Integer.parseInt(st.nextToken());
			int time = Integer.parseInt(st.nextToken());
			arr[start].add(new Node(end, time));
		}
		func();
		for (int i = 1; i <= N; i++) {
			func2(i);
		}
		System.out.println(max);
	}
}
