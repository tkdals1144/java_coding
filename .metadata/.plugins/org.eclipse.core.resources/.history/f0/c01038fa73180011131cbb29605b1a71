package dijkstra;
import java.util.*;
import java.io.*;
public class B1446 {
	// N : 길 개수, D : 길 길이
	static int N, D;
	static int[] dist;
	static class Node {
		int end;
		int dist;
		public Node(int end, int dist) {
			super();
			this.end = end;
			this.dist = dist;
		}
	}
	static ArrayList<Node>[] arr;
	static void func() {
		dist = new int[D+1];
		Arrays.fill(dist, Integer.MAX_VALUE);
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> a.dist - b.dist);
		dist[0] = 0;
		pq.offer(new Node(0, 0));
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			if (now.end == D) break;
			System.out.println(dist[now.end]);
			
			if (dist[now.end] < now.dist) continue;
			if (arr[now.end].isEmpty()) {
				pq.offer(new Node(now.end+1, now.dist+1));
				dist[now.end+1] = dist[now.end] + 1;
			} else {
				for (Node next : arr[now.end]) {
					if (dist[next.end] > now.dist + next.dist) {
						dist[next.end] = now.dist + next.dist;
						System.out.println(next.end);
						pq.offer(new Node(next.end, dist[next.end]));
					}
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		D = Integer.parseInt(st.nextToken());
		arr = new ArrayList[D+1];
		for (int i = 0; i <= D; i++) {
			arr[i] = new ArrayList<>();
		}
		for (int i = 0; i < N; i++) {
			st = new StringTokenizer(br.readLine());
			int start = Integer.parseInt(st.nextToken());
			int end = Integer.parseInt(st.nextToken());
			int dist = Integer.parseInt(st.nextToken());
			if (D < end || dist <= start - end) continue;
			arr[start].add(new Node(end, dist));
		}
		func();
		System.out.println(dist[D]);
	}
}
