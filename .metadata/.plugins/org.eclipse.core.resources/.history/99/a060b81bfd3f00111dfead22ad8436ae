package floyd;
import java.io.*;
import java.util.*;
public class B12908 {
	static class Node {
		int x, y;
		public Node(int x, int y) {
			super();
			this.x = x;
			this.y = y;
		}
	}
	static int xs, ys, xe, ye;
	static Node[] nodes = new Node[8];
	static int[][] dist = new int[8][8];
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		xs = Integer.parseInt(st.nextToken());
		ys = Integer.parseInt(st.nextToken());
		st = new StringTokenizer(br.readLine());
		xe = Integer.parseInt(st.nextToken());
		ye = Integer.parseInt(st.nextToken());
		nodes[0] = new Node(xs, ys);
		nodes[1] = new Node(xs, ys);
		int idx = 2;
		for (int i = 0; i < 3; i++) {
			st = new StringTokenizer(br.readLine());
			int startX = Integer.parseInt(st.nextToken());
			int startY = Integer.parseInt(st.nextToken());
			int endX = Integer.parseInt(st.nextToken());
			int endY = Integer.parseInt(st.nextToken());
			nodes[idx++] = new Node(startX, startY);
			nodes[idx++] = new Node(endX, endY);
		}
		for (int i = 0; i < 8; i++) {
			for (int j = 0; j < 8; j++) {
				if (i == j) dist[i][j] = 0;
				else {
					dist[i][j] = Math.abs(nodes[i].x - nodes[j].x)
							+ Math.abs(nodes[i].y - nodes[j].y);
				}
			}
		}
		for (int i = 2; i < 8; i += 2) {
			dist[i][i+1] = Math.min(dist[i][i+1], 10);
			dist[i+1][i] = Math.min(dist[i+1][i], 10);
		}
		for (int k = 0; k < 8; k++) {
			for (int i = 0; i < 8; i++) {
				for (int j = 0; j < 8; j++) {
					dist[i][j] = Math.min(dist[i][j], dist[i][k] + dist[k][j]);
				}
			}
		}
		System.out.println(dist[0][1]);
	}
}
