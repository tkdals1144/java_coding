package Studying;
import java.util.*;

public class B24313 {
	
	static int check(int a1, int a0, int c, int n0) {
		if (a1 * n0 + a0 > c * n0 || a1 > c) {
			return 0;
		} else if (a1 == c && 0 < a0) {
			return 0;
		} else {
			return 1;
		}
	}
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		int a1 = sc.nextInt();
		int a0 = sc.nextInt();;
		int c = sc.nextInt();
		int n0 = sc.nextInt();
		
		int output = check(a1, a0, c, n0);
		System.out.println(output);
	}
}
