package Studying;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class Test {
	// 시행횟수 N
	static int N;
	static int count = 0;
	static double func() {
		for (int i = 0; i < N; i++) {
			switch (count) {
			int value = random();
			case 0:
				if (value <= 80) count++;
				break;
			case 1:
				if (value <= 70) count++;
				break;
			case 2:
				if (value <= 70) count++;
				break;
			case 3:
				if (value <= 70) count++;
				break;
			case 4:
				if (value <= 70) count++;
				break;
			case 5:
				if (value <= 70) count++;
				break;
			case 6:
				if (value <= 70) count++;
				break;
			case 7:
				if (value <= 70) count++;
				break;
			}
		}
	}
	// 0 ~ 100
	static int random() {
		return (int)(Math.random() * 101);
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
	}
}
