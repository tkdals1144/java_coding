package star;
import java.io.*;

public class B2448 {
	static int N;
	// 0 -> 공백, 1 -> 별
	static int[][] graph;
	static void func(int n, int y, int x) {
		// base n == 3
		if (n == 3) {
			graph[y][x] = 1;
			graph[y+1][x-1] = 1;
			graph[y+1][x+1] = 1;
			for (int i = -2; i <= 2; i++) {
				graph[y+2][x+i] = 1;
			}
			return;
		}
		// 5로 들어갔는데 이 시발 족같은 색끼가 애미가 뒤져간지고
		// x 값이 5로 들어갔다니까? 개시발련아?
		// n/2 이면 이 값은 3이 되겠지?
		// 그럼 x - 2/n 을 하면 2가 들어가야겠지?
		// 그럼 func(3, 3, 2) 가 되어야겠지?
		func(2/n, y, x);
		func(2/n, y + 2/n, x - 2/n);
		func(2/n, y + 2/n, x + 2/n);
		
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		N = Integer.parseInt(br.readLine());
		graph = new int[N][2*N-1];
		func(N, 0, N-1);
		for (int i = 0; i < graph.length; i++) {
			for (int j = 0; j < graph[i].length; j++) {
				sb.append(graph[i][j]);
			}
			sb.append('\n');
		}
		System.out.println(sb.toString());
	}
}
