package bfs;
import java.util.*;
import java.io.*;
public class B7569 {
	static int M, N, H;
	static int[] dx = {-1, 1, 0, 0, 0, 0};
	static int[] dy = {0, 0, -1, 1, 0, 0};
	static int[] dz = {0, 0, 0, 0, -1, 1};
	static int[][][] graph;
	static int[][][] dist;
	
	static void bfs() {
		Deque<int[]> deque = new ArrayDeque<>();
		// 최초 토마토 추가
		for (int i = 0; i < H; i++) {
			for (int j = 0; j < N; j++) {
				for (int k = 0; k < M; k++) {
					if (graph[i][j][k] == 1) {
						// x, y, z 순으로 추가
						deque.offerLast(new int[] {k, j, i});
					}
				}
			}
		}
		// 하루가 지날때마다 익어감
		// 전체 배열이 한번 돌아갈 때마다 count를 증가시키는게 관건
		while (!deque.isEmpty()) {
			int[] xyz = deque.pollFirst();
			for (int i = 0; i < 6; i++) {
				int nx = xyz[0] + dx[i];
				int ny = xyz[1] + dy[i];
				int nz = xyz[2] + dz[i];
				if (0 <= nx && 0 <= ny && 0 <= nz && nx < M && ny < N && nz < H && graph[nz][ny][nx] == 0) {
					deque.offerLast(new int[] {nx, ny, nz});
					graph[nz][ny][nx] = 1;
					dist[nz][ny][nx] = dist[xyz[2]][xyz[1]][xyz[0]] + 1;
				}
			}
		}
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		M = Integer.parseInt(st.nextToken());
		N = Integer.parseInt(st.nextToken());
		H = Integer.parseInt(st.nextToken());
		graph = new int[H][N][M];
		dist = new int[H][N][M];
		int count = 0;
		// 만약 다 안익었다면 false로 변경
		boolean check = true;
		for (int i = 0; i < H; i++) {
			for (int j = 0; j < N; j++) {
				st = new StringTokenizer(br.readLine());
				for (int k = 0; k < M; k++) {
					graph[i][j][k] = Integer.parseInt(st.nextToken());
				}
			}
		}
		// 익었는가 안익었는가 확인하는 과정
		for (int i = 0; i < H; i++) {
			for (int j = 0; j < N; j++) {
				for (int k = 0; k < M; k++) {
					if (graph[i][j][k] == 0) check = false;
				}
			}
		}
		// 최대횟수가 몇인지 확인하는 과정
		for (int i = 0; i < H; i++) {
			for (int j = 0; j < N; j++) {
				for (int k = 0; k < M; k++) {
					if (count < dist[i][j][k]) {
						count = dist[i][j][k];
					}
				}
			}
		}
		if (check) {
			System.out.println(count);
		} else {
			System.out.println(-1);
		}
	}
}
