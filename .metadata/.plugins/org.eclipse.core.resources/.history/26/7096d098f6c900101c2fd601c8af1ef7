package backTracking;
import java.io.*;
import java.util.*;

public class B9663 {
	static int N;
	static int count = 0;
	// 세로방향, 대각선 두개
	static boolean[] visited1, visited2, visited3;
	
	// 3 2 1 0     0 1 2 3
	// 4 3 2 1     1 2 3 4
	// 5 4 3 2     2 3 4 5
	// 6 5 4 3     3 4 5 6
	
	static void dfs(int row) {
		if (row == N-1) {
			count++;
			return;
		}
		for (int col = 0; col < N; col++) {
			if (visited1[col] || visited1[col+row] || visited2[N-col+row-1]) continue;
			visited1[col] = true;
			visited2[col+row] = true;
			visited3[N-col+row-1] = true;
			dfs(row+1);
			visited1[col] = false;
			visited2[col+row] = false;
			visited3[N-col+row-1] = false;
		}
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		visited1 = new boolean[N];
		visited2 = new boolean[2*N-1];
		visited3 = new boolean[2*N-1];
		dfs(0);
		System.out.println(count);
	}
}
