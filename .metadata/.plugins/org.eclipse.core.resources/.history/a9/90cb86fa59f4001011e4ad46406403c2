package divideAndConquer;
import java.util.*;
import java.io.*;
public class B1780 {
	static int N;
	static int[][] graph;
	static int minus = 0;
	static int zero = 0;
	static int plus = 0;
	static void divide(int x, int y, int size) {
		if (isSame(x, y, size)) {
			if (graph[x][y] == -1) minus++;
			else if (graph[x][y] == 0) zero++;
			else plus++;
			return;
		}
		
		int divideNum = size / 3;
		
		for (int i = 0; i < size; i += divideNum) {
			for (int j = 0; j < size; j += divideNum) {
				divide(i, j, divideNum);
			}
		}
	}
	static boolean isSame(int x, int y, int size) {
		if (size == 1) return true;
		for (int i = x; i < x + size; i++) {
			for (int j = y; j < y + size; j++) {
				if (graph[i][j] != graph[x][y]) return false;
			}
		}
		return true;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		graph = new int[N][N];
		for (int i = 0; i < N; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			for (int j = 0; j < N; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
			}
		}
		divide(0, 0, N);
		System.out.println(minus);
		System.out.println(zero);
		System.out.println(plus);
	}
}
