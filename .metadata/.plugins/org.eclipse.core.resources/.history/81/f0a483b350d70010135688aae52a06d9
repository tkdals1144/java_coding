package dp;
import java.util.*;
import java.io.*;

public class B11053 {
	static int[] arr;
	static int[][] dp;
	static int maxCount = 0;
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int N = Integer.parseInt(br.readLine());
		arr = new int[N];
		dp = new int[N][2];
		// {10, 1} {20, 2} {10, 1} {30, 2 or 3 -> 30, 3} {20, 2} {50, 4 or 3 -> 50, 4}
		StringTokenizer st = new StringTokenizer(br.readLine());
		for (int i = 0; i < N; i++) {
			dp[i][0] = Integer.parseInt(st.nextToken());
			dp[i][1] = 1;
		}

		// 0번째에는 실제 값, 1번째에는 현재까지 쌓인 개수
		// 기존보다 작은 값들이 존재하는가? 를 판별해야 하기에 2중 for문을 사용
		for (int i = 1; i < N; i++) {
			// 임시로 저장해둘 값
			int temp = 0;
			// 제일 가까운것부터 판단하는것이 좋음. 다만 더 큰것이 있다면 그걸 추가해야 함.
			for (int j = i; 0 <= j; j--) {
				// 앞에것들이 더 크다면 continue
				if (dp[i][0] < dp[j][0]) continue;
				temp = Math.max(temp, dp[j][1]);
				System.out.println(temp);
			}
			dp[i][1] += temp;
		}
		for (int i = 0; i < N; i++) {
			maxCount = Math.max(maxCount, dp[i][1]);
		}
		System.out.println(maxCount);
	}
}
