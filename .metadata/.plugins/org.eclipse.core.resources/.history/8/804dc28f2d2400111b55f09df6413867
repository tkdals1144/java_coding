package dijkstra;
import java.io.*;
import java.util.*;
public class B9505 {
	static final long INF = 1000000000000L;
	static class Node {
		int x, y;
		long cost;
		public Node(int x, int y, long cost) {
			super();
			this.x = x;
			this.y = y;
			this.cost = cost;
		}
	}
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	static StringBuilder sb = new StringBuilder();
	// K : 클래스 개수, W : 평면의 폭, H : 평면의 높이
	static int K, W, H;
	static int startX, startY;
	static int[][] graph;
	static long[][] dist;
	static Map<Character, Integer> map;
	static void reset() {
		graph = new int[H][W];
		dist = new long[H][W];
		for (int i = 0; i < dist.length; i++) {
			Arrays.fill(dist[i], INF);
		}
		map = new HashMap<>();
	}
	static void dijkstra() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return Long.compare(a.cost, b.cost);
		});
		pq.offer(new Node(startX, startY, 0));
		dist[startY][startX] = 0;
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			if (now.cost > graph[now.y][now.x]) continue;
			for (int i = 0; i < 4; i++) {
				int nx = now.x + dx[i];
				int ny = now.y + dy[i];
				if (check(nx, ny)) {
					if (dist[ny][nx] > now.cost + graph[ny][nx]) {
						dist[ny][nx] = now.cost + graph[ny][nx];
						pq.offer(new Node(nx, ny, dist[ny][nx]));
					}
				}
			}
		}
		long min = INF;
		for (int i = 0; i < H; i++) {
			for (int j = 0; j < W; j++) {
				if (i == 0 || j == 0 || i == H-1 || j == W-1) {
					min = Math.min(min, dist[i][j]);
				}
			}
		}
		sb.append(min).append('\n');
	}
	static boolean check(int x, int y) {
		return x >= 0 && y >= 0 && x < W && y < H;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int T = Integer.parseInt(br.readLine());
		for (int i = 0; i < T; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			K = Integer.parseInt(st.nextToken());
			W = Integer.parseInt(st.nextToken());
			H = Integer.parseInt(st.nextToken());
			reset();
			for (int j = 0; j < K; j++) {
				st = new StringTokenizer(br.readLine());
				char name = st.nextToken().charAt(0);
				int time = Integer.parseInt(st.nextToken());
				map.put(name, time);
			}
			for (int k = 0; k < H; k++) {
				char[] input = br.readLine().toCharArray();
				for (int l = 0; l < W; l++) {
					if (input[l] == 'E') {
						startX = l;
						startY = k;
					} else {
						graph[k][l] = map.get(input[l]);
					}
				}
			}
			dijkstra();
		}
		System.out.println(sb.toString());
	}
}
