package dp;
import java.util.*;
import java.io.*;

public class B10844 {
	static int N;
	static int[] arr;
	static StringBuilder sb = new StringBuilder();
	static int count = 0;
	static void dfs(int depth) {
		if (depth == N) {
			sb.append(false);
			count++;
		}
		for (int i = 0; i <= 9; i++) {
			if (depth == 0) {
				if (i == 0) continue;
				arr[depth] = i;
				dfs(depth+1);
			} else {
				if (i == arr[depth-1] - 1 || i == arr[depth-1] + 1) {
					arr[depth] = i;
					dfs(depth+1);
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		arr = new int[N+1];
		dfs(0);
		System.out.println(count);
	}
}
