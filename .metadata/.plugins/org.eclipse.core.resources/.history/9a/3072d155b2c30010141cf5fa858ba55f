package bfs;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.ArrayDeque;
import java.util.Queue;
import java.util.StringTokenizer;

public class B2573 {
	// y축 N, x축 M
	static int N, M;
	// 빙산의 현재 높이
	static int[][] graph;
	// 감소 가중치
	static int[][] weight;
	// 방문 여부
	static boolean[][] visited;
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	// 현재 빙산의 개수
	static int count = 0;
	
	// 가중치 결정
	static void weightCount() {
		weight = new int[N][M];
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (graph[i][j] != 0) {
					for (int k = 0; k < 4; k++) {
						int ny = i + dy[k];
						int nx = j + dx[k];
						if (0 <= nx && 0 <= ny && nx < M && ny < N && graph[ny][nx] == 0) {
							weight[i][j]++;
						}
					}
				}
			}
		}
	}
	
	// 실제 개수와 같다면 true, 아니라면 false;
	static boolean linkCheck() {
		int linkedCount = 0;
		visited = new boolean[N][M];
		boolean breakloop = false;
		int x = 0, y = 0;
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (graph[i][j] != 0) {
					y = i;
					x = j;
					breakloop = true;
					break;
				}
			}
			if (breakloop) break;
		}
		Queue<int[]> q = new ArrayDeque<>();
		q.offer(new int[] {y, x});
		linkedCount++;
		visited[y][x] = true;
		while (!q.isEmpty()) {
			int[] yx = q.poll();
			for (int i = 0; i < 4; i++) {
				int nx = yx[1] + dx[i];
				int ny = yx[0] + dy[i];
				if (0 <= nx && 0 <= ny && nx < M && ny < N && graph[ny][nx] != 0
						&& !visited[ny][nx]) {
					q.offer(new int[] {ny, nx});
					linkedCount++;
					visited[ny][nx] = true;
				}
			}
		}
		return linkedCount == count;
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		int answer = 0;
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		graph = new int[N][M];
		weight = new int[N][M];
		for (int i = 0; i < N; i++) {
			st = new StringTokenizer(br.readLine());
			for (int j = 0; j < M; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
				if (graph[i][j] != 0) count++;
			}
		}
		weightCount();
		while (true) {
			// 시간이 지난다
			answer++;
			boolean check = false;
			for (int i = 0; i < N; i++) {
				for (int j = 0; j < M; j++) {
					if (graph[i][j] != 0) {
						graph[i][j] -= weight[i][j];
						// 충분히 작아졌다면...
						if (graph[i][j] <= 0) {
							graph[i][j] = 0;
							// 실제 빙산의 개수는 감소한다
							count--;
							check = true;
						}
					}
				}
			}
			// 빙산의 개수가 감소했다면 다시 계산해보아야 한다
			if (check) {
				if (!linkCheck()) {
					break;
				} else {
					weightCount();
				}
			}
			if (count == 0) {
				answer = 0;
				break;
			}
		}
		System.out.println(answer);
	}
}
