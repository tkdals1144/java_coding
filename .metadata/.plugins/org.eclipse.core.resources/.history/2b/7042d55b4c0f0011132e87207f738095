package priorityQueue;

import java.io.*;
import java.util.*;

public class B7662 {
	static int T;
	static Queue<Integer> minpq;
	static Queue<Integer> maxpq;
	static HashMap<Integer, Boolean> map;
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringBuilder sb = new StringBuilder();
		T = Integer.parseInt(br.readLine());
		for (int i = 0; i < T; i++) {
			minpq = new PriorityQueue<>((a, b) -> a - b);
			maxpq = new PriorityQueue<>((a, b) -> b - a);
			int k = Integer.parseInt(br.readLine());
			map = new HashMap<>();
			for (int j = 0; j < k; j++) {
				StringTokenizer st = new StringTokenizer(br.readLine());
				char c = st.nextToken().charAt(0);
				if (c == 'I') {
					int num = Integer.parseInt(st.nextToken());
					minpq.add(num);
					maxpq.add(num);
					map.put(num, true);
				} else {
					int choice = Integer.parseInt(st.nextToken());
					if (choice == 1) {
						if (!maxpq.isEmpty()) {
							int pollNum = maxpq.poll();
							if (map.get(pollNum)) {
								map.put(pollNum, false);
							}
						}
					} else {
						if (!minpq.isEmpty()) {
							int pollNum = minpq.poll();
							if (map.get(pollNum)) {
								map.put(pollNum, false);
							}
						}
					}
				}
			}
			if (!maxpq.isEmpty() && !minpq.isEmpty()) {
				int max = maxpq.poll();
				int min = minpq.poll();
				if (map.get(max) && map.get(min)) {
					sb.append(max + " " + min).append('\n');
				} else {
					sb.append("EMPTY").append('\n');
				}
			} else {
				sb.append("EMPTY").append('\n');
			}
		}
		System.out.println(sb.toString());
	}
}
