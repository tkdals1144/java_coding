package Studying;
import java.util.*;

public class B24265 {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		
		long n = sc.nextLong();
		long count = 0;
		for (long i = 1; i < n; i++) {
			for (long j = i + 1; j <= n; j++) {
				System.out.println("i : " + i);
				count++;
			}
		}
		System.out.println(count);
		System.out.println(2);
	}
}
