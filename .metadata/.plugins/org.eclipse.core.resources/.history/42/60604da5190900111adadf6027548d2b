package divideAndConquer;

import java.io.*;
import java.util.*;
public class B31455 {
	static int N;
	static int[][] arr;
	static int sum;
	static void divide(int i, int j, int size) {
		if (size == 1) {
			sum += arr[i][j];
			return;
		}
		int half = size / 2;
		int temp = 0;
		for (int l = i; l < size; l++) {
			for (int k = j; k < size; k++) {
				temp += arr[l][k];
			}
		}
		int divideNum = temp % 4;
		switch (divideNum) {
			case 0:
				divide(i, j+half, half);
				divide(i+half, j, half);
				divide(i+half, j+half, half);
				break;
			case 1:
				divide(i, j, half);
				divide(i+half, j, half);
				divide(i+half, j+half, half);
				break;
			case 2:
				divide(i, j, half);
				divide(i, j+half, half);
				divide(i+half, j+half, half);
				break;
			case 3:
				divide(i, j, half);
				divide(i, j+half, half);
				divide(i+half, j, half);
				break;
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int T = Integer.parseInt(br.readLine());
		for (int i = 0; i < T; i++) {
			sum = 0;
			N = Integer.parseInt(br.readLine());
			arr = new int[N][N];
			for (int j = 0; j < N; j++) {
				char[] ch = br.readLine().toCharArray();
				for (int k = 0; k < N; k++) {
					arr[j][k] = Integer.parseInt(ch[k] + "");
				}
				divide(0, 0, N);
			}
		}
	}
}
