package dp;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.util.Arrays;
import java.util.StringTokenizer;

public class B1106 {
	// C : 늘려야 할 사람, N : 홍보 가능한 도시의 개수
	// 출력 : 투자해야 할 돈의 최소값
	static int C, N;
	static int[] count;
	static int[][] select;
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		C = Integer.parseInt(st.nextToken());
		count = new int[C+100+1];
		Arrays.fill(count, Integer.MAX_VALUE);
		count[0] = 0;
		N = Integer.parseInt(st.nextToken());
		select = new int[N][2];
		for (int i = 0; i < N; i++) {
			st = new StringTokenizer(br.readLine());
			// key
			select[i][0] = Integer.parseInt(st.nextToken());
			// value
			select[i][1] = Integer.parseInt(st.nextToken());
		}
		for (int i = 0; i < N; i++) {
			int key = select[i][0];
			int value = select[i][1];
			
			for (int j = value; j < count.length; j++) {
				count[j] = Math.min(count[j], count[j - value] + key);
			}
		}
		int answer = Integer.MAX_VALUE;
		for (int i = C; i < count.length; i++) {
			answer = Math.min(answer, count[i]);
			System.out.println(answer);
		}
		
		System.out.println(answer);
	}
}
