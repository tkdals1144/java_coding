package Studying;
import java.util.*;
import java.io.*;

public class B2447 {
	
	static String gap(int N) {
		StringBuilder sb = new StringBuilder();
		for (int i = 0; i < N/3; i++) {
			for (int j = 0; j < N/3; j++) {
				sb.append("Tl");
			}
			sb.append('\n');
		}
		return sb.toString();
	}
	static String func(int N) {
		StringBuilder sb = new StringBuilder();
		if (N == 1) {
			return "*";
		}
		for (int i = 0; i < 3; i++) {
			for (int j = 0; j < 3; j++) {
				if (i == 1 && j == 1) {
					sb.append(gap(N/3));
				} else {
					sb.append(func(N/3));
				}
			}
			sb.append('\n');
		}
		return sb.toString();
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int N = Integer.parseInt(br.readLine());
		String output = func(N);
		System.out.println(output);
	}
}
