package bfs;
import java.util.*;
import java.io.*;
class Node {
	public int loc;
	public Node next;
	public Node(int loc) {
		this.loc = loc;
	}
	public Node(int loc, Node next) {
		this.loc = loc;
		this.next = next;
	}
}
public class B13913 {
	static int N, K;
	static int[] dist;
	static Node[] nodeList;
	static void bfs(int start) {
		Queue<Integer> q = new ArrayDeque<>();
		q.offer(start);
		dist[N] = 0;
		Node node = new Node(start);
		nodeList[start] = node;
		while (!q.isEmpty()) {
			int loc = q.poll();
			if (loc != 0 && loc*2 < dist.length && dist[loc*2] == -1) {
				q.offer(loc*2);
				dist[loc*2] = dist[loc] + 1;
				nodeList[loc*2] = new Node(loc*2, nodeList[loc]);
			}
			if (loc+1 < dist.length && dist[loc+1] == -1) {
				q.offer(loc+1);
				dist[loc+1] = dist[loc] + 1;
				nodeList[loc+1] = new Node(loc+1, nodeList[loc]);
				
			}
			if (0 <= loc-1 && dist[loc-1] == -1) {
				q.offer(loc-1);
				dist[loc-1] = dist[loc] + 1;
				nodeList[loc-1] = new Node(loc-1, nodeList[loc]);
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		K = Integer.parseInt(st.nextToken());
		dist = new int[Math.max(N, K) + 1];
		nodeList = new Node[Math.max(N, K) + 1];
		Arrays.fill(dist, -1);
		bfs(N);
		System.out.println(dist[K]);
		Node node = nodeList[K];
		while (true) {
			System.out.println(node.loc);
			if (node.next == null) break;
			node = node.next;
		}
	}
}
