package string;
import java.util.*;
import java.io.*;
public class B5525 {
	static int N, M;
	static char[] arr;
	static int count;
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		M = Integer.parseInt(br.readLine());
		arr = br.readLine().toCharArray();
		ArrayList<Integer> list = new ArrayList<>();
		boolean check = false;
		for (int i = 0; i < M; i++) {
			// 현재 I로 시작된 상태라면
			if (check) {
				// 이전것과 다르다면 패턴이 이어지고 있음
				if (arr[i] != arr[i-1]) {
					count++;
				} else {
					list.add((count-1) / 2);
					if (arr[i] == 'I') {
						count = 1;
					} else {
						check = false;
					}
				}
			} else {
				// 현재 I로 시작되지 않았다면
				if (arr[i] == 'I') check = true;
				count = 1;
			}
		}
		// A = 2B + 1
		// B = (A-1) / 2
	}
}
