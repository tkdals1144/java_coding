package backTracking;
import java.io.*;
import java.util.*;

public class B14889 {
	static int N;
	static int min = Integer.MAX_VALUE;
	static int[][] graph;
	static boolean[][] visited;
	// 1 2 3 4
	// 1 2 / 3 4
	// 1 3 / 2 4
	// 1 4 / 2 3
	static void dfs(int depth) {
		int team1 = 0;
		int team2 = 0;
		if (depth == N / 2) {
			for (int i = 0; i < N; i++) {
				for (int j = 0; j < N; j++) {
					if (visited[i][j]) team1 += graph[i][j];
					else team2 += graph[i][j];
				}
			}
			int value = Math.abs(team1 - team2);
			if (value < min) min = value;
		}

		// x축은 절반만 검사해도 전체탐색이 가능하다
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < N / 2; j++) {
				if (visited[i][j] || i == j) continue;
				visited[i][j] = true;
				visited[j][i] = true;
				dfs(depth + 1);
				visited[i][j] = false;
				visited[j][i] = false;
			}
		}
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		graph = new int[N][N];
		visited = new boolean[N][N];
		for (int i = 0; i < N; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			for (int j = 0; j < N; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
			}
		}
		dfs(0);
	}
}
