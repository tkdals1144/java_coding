package bfs;
import java.io.*;
import java.util.*;

public class B2636 {
	// 세로길이 N, 가로길이 M
	// 결국 문제 해결의 키는 가장 바깥쪽과 연결되었는가? 그리고 치즈가 녹은후 내부가 외부와 노출되었는가?
	static int N, M;
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	// 0 : 아직 확인되지 않은 공간, 1 : 현재 치즈가 있는 공간, 2 : 외부와 접촉된 공간, 3 : 치즈가 녹아 사라진 공간
	static int[][] graph;
	static int[][] dist;
	static void resetBfs(int i, int j) {
		graph[i][j] = 2;
		dist[i][j] = 0;
		Queue<int[]> q = new ArrayDeque<>();
		q.offer(new int[] {i, j});
		while(!q.isEmpty()) {
			int[] yx = q.poll();
			for (int k = 0; k < 4; k++) {
				int ny = yx[0] + dy[k];
				int nx = yx[1] + dx[k];
				if (check(ny, nx) && graph[ny][nx] == 0) {
					graph[ny][nx] = 2;
					dist[ny][nx] = 0;
					q.offer(new int[] {ny, nx});
				}
			}
		}
	}
	static boolean method1(int distvalue) {
		boolean check = false;
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (dist[i][j] == -1 && graph[i][j] == 1) {
					int y = i;
					int x = j;
					for (int k = 0; k < 4; k++) {
						int ny = y + dy[k];
						int nx = x + dx[k];
						if (check(ny, nx) && graph[ny][nx] == 2 || graph[ny][nx] == 3
								&& dist[ny][nx] == distvalue) {
							graph[y][x] = 3;
							dist[y][x] = distvalue + 1;
							check = true;
						}
					}
				}
			}
		}
		return check;
	}
	static void resetBfs2() {
		Queue<int[]> q = new ArrayDeque<>();
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (dist[i][j] == -1 && graph[i][j] == 0) {
					for (int k = 0; k < 4; k++) {
						int ny = i + dy[k];
						int nx = j + dx[k];
						if (check(ny, nx) && graph[ny][nx] == 2 || graph[ny][nx] == 3) {
							q.offer(new int[] {i, j});
							dist[i][j] = graph[ny][nx];
						}
					}
				}
			}
		}
		while (!q.isEmpty()) {
			int[] yx = q.poll();
			for (int i = 0; i < 4; i++) {
				int ny = yx[0] + dy[i];
				int nx = yx[1] + dx[i];
				if (check(ny, nx) && graph[ny][nx] == 0) {
					graph[ny][nx] = 2;
					q.offer(new int[] {ny, nx});
					dist[ny][nx] = graph[yx[0]][yx[1]];
				}
			}
		}
	}
	static boolean check(int y, int x) {
		return 0 <= y && y < N && 0 <= x && x < M;
	}
	
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		boolean breakTime = true;
		int time = 0;
		int count = 0;
		graph = new int[N][M];
		dist = new int[N][M];
		for (int i = 0; i < N; i++) {
			Arrays.fill(dist[i], -1);
		}
		for (int i = 0; i < N; i++) {
			st = new StringTokenizer(br.readLine());
			for (int j = 0; j < M; j++) {
				graph[i][j] = Integer.parseInt(st.nextToken());
			}
		}
		graph[0][0] = 2;
		resetBfs(0, 0);
		while (true) {
			StringBuilder sb = new StringBuilder();
			breakTime = method1(time);
			resetBfs2();
			for (int i = 0; i < N; i++) {
				for (int j = 0; j < M; j++) {
					sb.append(graph[i][j] + " ");
				}
				sb.append('\n');
			}
			if (!breakTime) break;
			System.out.println(sb.toString());
			time++;
		}
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (dist[i][j] == time) count++;
			}
		}
		System.out.println(time);
		System.out.println(count);
	}
}
