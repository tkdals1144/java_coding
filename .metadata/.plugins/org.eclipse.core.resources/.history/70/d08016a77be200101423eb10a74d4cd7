package Studying;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class Test {
	// 시행횟수 N
	static int N;
	static int count;
	static int all;
	static int success = 0;
	static StringBuilder sb = new StringBuilder();
	static void func() {
		for (int i = 0; i < N; i++, all--) {
			if (count == 8) break;
			int value = random();
			switch (count) {
			case 0:
				if (value <= 80) count++;
				break;
			case 1:
				if (value <= 70) count++;
				break;
			case 2:
				if (value <= 60) count++;
				break;
			case 3:
				if (value <= 50) count++;
				break;
			case 4:
				if (value <= 40) count++;
				break;
			case 5:
				if (value <= 30) count++;
				break;
			case 6:
				if (value <= 10) count++;
				break;
			case 7:
				if (value <= 5) count++;
				break;
			}
		}
		if (count == 8) success++;
	}
	// 0 ~ 100
	static int random() {
		return (int)(Math.random() * 101);
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N = Integer.parseInt(br.readLine());
		for (int i = 0; i < 10000; i++) {
			count = 0;
			all = N;
			func();
		}
		System.out.println(success);
	}
}
