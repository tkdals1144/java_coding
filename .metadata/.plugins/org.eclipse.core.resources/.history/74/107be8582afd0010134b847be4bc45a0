package bfs;
import java.util.*;
import java.io.*;
public class B3184 {
	static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
	static int N, M;
	static char[][] graph;
	static boolean[][] visited;
	static int sheep = 0;
	static int wolf = 0;
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	// . : 빈 필드
	// # : 울타리
	// o : 양
	// v : 늑대
	static void reset() throws IOException {
		graph = new char[N][M];
		visited = new boolean[N][M];
		for (int i = 0; i < N; i++) {
			char[] input = br.readLine().toCharArray();
			for (int j = 0; j < M; j++) {
				graph[i][j] = input[j];
			}
		}
	}
	static void time() {
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < M; j++) {
				if (check(i, j)) bfs(i, j);
			}
		}
	}
	static void bfs(int y, int x) {
		int tempSheep = 0;
		int tempWolf = 0;
		Queue<int[]> q = new ArrayDeque<>();
		q.offer(new int[] {y, x});
		if (graph[y][x] == 'o') tempSheep++;
		if (graph[y][x] == 'v') tempWolf++;
		visited[y][x] = true;
		while (!q.isEmpty()) {
			int[] yx = q.poll();
			for (int i = 0; i < 4; i++) {
				int ny = yx[0] + dy[i];
				int nx = yx[1] + dx[i];
				if (check(ny, nx)) {
					q.offer(new int[] {ny, nx});
					if (graph[ny][nx] == 'o') tempSheep++;
					if (graph[ny][nx] == 'v') tempWolf++;
					visited[ny][nx] = true;
				}
			}
		}
	}
	static boolean check(int y, int x) {
		return !visited[y][x] && graph[y][x] != '#';
	}
	public static void main(String[] args) throws IOException {
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		reset();
		bfs();
	}
}
