package backTracking;
import java.util.*;
import java.io.*;

public class B2580 {
	static int[][] arr = new int[9][9];
	static ArrayList<int[]> blanks = new ArrayList<>();
	// 처음엔 하나도 채우지 못한 상태 dfs(0)
	static void dfs(int depth) {
		if (depth == blanks.size()) {
			
			System.exit(0);
		}
		int y = blanks.get(depth)[0];
		int x = blanks.get(depth)[1];
		for (int i = 1; i <= 9; i++) {
			if (check(x, y, i)) {
				arr[y][x] = i;
				dfs(depth + 1);
				arr[y][x] = 0;
			}
		}
	}
	boolean check(int x, int y, int num) {
		// 가로부터 검사
		for (int i = 0; i < 9; i++) {
			if (arr[y][i] == num) return false;
		}
		
		for (int i = 0; i < 9; i++) {
			if (arr[i][x] == num) return false;
		}
		int nx = (x/3)*3;
		int ny = (y/3)*3;
		for (int i = 0; i < 3; i++) {
			for (int j = 0; j < 3; j++) {
				if (arr[ny+i][nx+j] == num) return false;
			}
		}
		return true;
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		for (int i = 0; i < 9; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			for (int j = 0; j < 9; j++) {
				arr[i][j] = Integer.parseInt(st.nextToken());
				if (arr[i][j] == 0) blanks.add(new int[] {i, j});
			}
		}
	}
}
