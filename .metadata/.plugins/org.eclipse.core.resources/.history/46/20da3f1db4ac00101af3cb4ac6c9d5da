	static void func(int N, int from, int to, int mid) {
		if (N == 1) {
			// top3에 1개를 쌓는 방법
			sb.append(from).append(" ").append(to).append('\n');
			count++;
		} else {
			func(N-1, from, mid, to);
			sb.append(from).append(" ").append(to).append('\n');
			count++;
			func(N-1, mid, to, from);
		}
	}
	
