package dijkstra;

import java.io.*;
import java.util.*;

public class B5972 {
	// N : 정점, M : 간선
	static int N, M;
	static int max = 0;
	static class Node {
		int to;
		int cost;
		public Node(int to, int cost) {
			super();
			this.to = to;
			this.cost = cost;
		}
	}
	static ArrayList<Node>[] arr;
	static int[] dist;
	static void func() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.cost - b.cost;
		});
		pq.add(new Node(1, 0));
		dist[1] = 0;
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			System.out.println(now.cost);
			System.out.println(dist[now.to]);
			if (now.cost > dist[now.to]) continue;
			for (Node next : arr[now.to]) {
				if (dist[next.to] > next.cost + now.cost) {
					dist[next.to] = next.cost + now.cost;
					pq.offer(new Node(next.to, dist[next.to]));
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		dist = new int[N+1];
		Arrays.fill(dist, Integer.MAX_VALUE);
		arr = new ArrayList[N+1];
		for (int i = 1; i <= N; i++) {
			arr[i] = new ArrayList<>();
		}
		for (int i = 0; i < M; i++) {
			st = new StringTokenizer(br.readLine());
			int start = Integer.parseInt(st.nextToken());
			int end = Integer.parseInt(st.nextToken());
			int weight = Integer.parseInt(st.nextToken());
			arr[start].add(new Node(end, weight));
		}
		func();
		for (int i = 1; i <= N; i++) {
			System.out.println(dist[i]);
			max = Math.max(max, dist[i]);
		}
		System.out.println(max);
	}
}
