package dijkstra;
import java.io.*;
import java.util.*;
public class B20168 {
	// 교차로 개수 N, 골목 개수 M, 시작 A, 도착 B, 소지금 C
	static int N, M, A, B, C;
	static class Node {
		int to;
		int cost;
		int shame;
		public Node(int to, int cost, int shame) {
			super();
			this.to = to;
			this.cost = cost;
			this.shame = shame;
		}
	}
	static int[] dist;
	static int[] shame;
	static ArrayList<Node>[] arr;
	static void reset() {
		dist = new int[N+1];
		shame = new int[N+1];
		arr = new ArrayList[N+1];
		for (int i = 1; i <= N; i++) {
			arr[i] = new ArrayList<>();
		}
		Arrays.fill(dist, Integer.MAX_VALUE);
		Arrays.fill(shame, Integer.MAX_VALUE);
	}
	static void dijkstra() {
		PriorityQueue<Node> pq = new PriorityQueue<>((a, b) -> {
			return a.cost - b.cost;
		});
		pq.offer(new Node(A, 0, 0));
		dist[A] = 0;
		shame[A] = 0;
		while (!pq.isEmpty()) {
			Node now = pq.poll();
			// 원래는 불필요하지만 이 문제는 소지금 내에서만 이동하면 되기에 제함
//			if (now.cost > dist[now.to]) continue;
			for (Node next : arr[now.to]) {
				int cost = now.cost + next.cost;
				// 지금까지의 최대 수치심과 현재 노드의 수치심을 비교
				int temp = Math.max(now.shame, next.shame);
				if (dist[next.to] > cost && cost <= C) {
					dist[next.to] = cost;
					pq.offer(new Node(next.to, dist[next.to], temp));
					// 해당 노드의 수치심 중 최소값을 저장해야 함
					shame[next.to] = Math.min(shame[next.to], temp);
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		A = Integer.parseInt(st.nextToken());
		B = Integer.parseInt(st.nextToken());
		C = Integer.parseInt(st.nextToken());
		reset();
		for (int i = 0; i < M; i++) {
			st = new StringTokenizer(br.readLine());
			int start = Integer.parseInt(st.nextToken());
			int end = Integer.parseInt(st.nextToken());
			int cost = Integer.parseInt(st.nextToken());
			arr[start].add(new Node(end, cost, cost));
			arr[end].add(new Node(start, cost, cost));
		}
		dijkstra();
		System.out.println(shame[B]);
	}
}
