package Studying;
import java.util.*;
import java.io.*;

public class B2447 {
	static boolean[][] graph;
	
	static void func(int N, int k, int l) {
		if (N != 1) {
			// 3 6 9 로 껑충 뛰어야 함
			// N = 3 일때, i = 1
			// 현재 문제는 9개로 쪼개진것의 첫번째꺼만 혜택을 받는다는거임
			// 9개로 쪼개진것의 두번째 세번째도 혜택을 봐야함
			// 걍 이 방법은 실패함
			for (int i = N*k + N/3; i < N*k + N/3 + N/3; i++) {
				for (int j = N*l + N/3; j < N*l + N/3 + N/3; j++) {
					graph[i][j] = false;
				}
			}
			for (int i = 0; i < 3; i++) {
				for (int j = 0; j < 3; j++) {
					func(N/3, i, j);
				}
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		int N = Integer.parseInt(br.readLine());
		StringBuilder sb = new StringBuilder();
		graph = new boolean[N][N];
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < N; j++) {
				graph[i][j] = true;
			}
		}
		func(N, 0, 0);
		
		for (int i = 0; i < N; i++) {
			for (int j = 0; j < N; j++) {
				if (graph[i][j]) sb.append("*");
				else sb.append(" ");
			}
			sb.append('\n');
		}
		System.out.println(sb.toString());
	}
}
