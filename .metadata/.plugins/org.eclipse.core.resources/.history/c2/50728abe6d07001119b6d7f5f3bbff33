package backTracking;

import java.io.*;
import java.util.StringTokenizer;

public class B2961 {
	static int N;
	static int answer;
	static class Tasty {
		int sour;
		int bitter;
		boolean visited;
		public Tasty(int sour, int bitter) {
			super();
			this.sour = sour;
			this.bitter = bitter;
			this.visited = false;
		}
	}
	static Tasty[] choice;
	static void dfs(int depth, int sour, int bitter, boolean selected) {
		if (depth == N) {
			if (selected) {
				answer = Math.min(answer, Math.abs(sour - bitter));
			}
			return;
		}
		dfs(depth+1, sour * choice[depth].sour, bitter + choice[depth].bitter, true);
		dfs(depth+1, sour, bitter, selected);
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		N  = Integer.parseInt(br.readLine());
		choice = new Tasty[N];
		for (int i = 0; i < N; i++) {
			StringTokenizer st = new StringTokenizer(br.readLine());
			int a = Integer.parseInt(st.nextToken());
			int b = Integer.parseInt(st.nextToken());
			choice[i] = new Tasty(a, b);
		}
		dfs(0, 1, 0, false);
		System.out.println(answer);
	}
}
