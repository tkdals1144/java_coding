package prefixSum;
import java.util.*;
import java.io.*;
public class B25682 {
	static int N, M, K;
	static char[][] firstBlack;
	static char[][] firstWhite;
	static int[][] BlackDp;
	static int[][] WhiteDp;
	static int min = Integer.MAX_VALUE;
	static void reset() {
		boolean check = false;
		firstBlack = new char[N+1][M+1];
		firstWhite = new char[N+1][M+1];
		BlackDp = new int[N+1][M+1];
		WhiteDp = new int[N+1][M+1];
		for (int i = 1; i <= N; i++) {
			for (int j = 1; j <= M; j++) {
				check = !check;
				if (check) {
					firstBlack[i][j] = 'B';
					firstWhite[i][j] = 'W';
				} else {
					firstBlack[i][j] = 'W';
					firstWhite[i][j] = 'B';
				}
			}
			check = !check;
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		N = Integer.parseInt(st.nextToken());
		M = Integer.parseInt(st.nextToken());
		K = Integer.parseInt(st.nextToken());
		reset();
		for (int i = 1; i <= N; i++) {
			char[] input = br.readLine().toCharArray();
			for (int j = 1; j <= M; j++) {
				if (firstBlack[i][j] == input[j-1]) {
					BlackDp[i][j] = BlackDp[i-1][j] + BlackDp[i][j-1] - BlackDp[i-1][j-1];
					WhiteDp[i][j] = WhiteDp[i-1][j] + WhiteDp[i][j-1] - WhiteDp[i-1][j-1] + 1;
				} else {
					BlackDp[i][j] = BlackDp[i-1][j] + BlackDp[i][j-1] - BlackDp[i-1][j-1] + 1;
					WhiteDp[i][j] = WhiteDp[i-1][j] + WhiteDp[i][j-1] - WhiteDp[i-1][j-1];
				}
			}
		}
		for (int i = 1; i <= N; i++) {
			for (int j = 1; j <= M; j++) {
				System.out.print(BlackDp[i][j]);
			}
			System.out.println();
		}
		// 4 4 3 -> 1 ~ 2 && 3 ~ 4
		for (int i = 1; i <= N - K + 1; i++) {
			for (int j = 1; j <= M - K + 1; j++) {
				min = Math.min(min, BlackDp[i+K-1][j+K-1] - BlackDp[i+K-1][j-1]
						-BlackDp[i-1][j+K-1] + BlackDp[i-1][j-1]);
				min = Math.min(min, WhiteDp[i+K-1][j+K-1] - WhiteDp[i+K-1][j-1]
						-WhiteDp[i-1][j+K-1] + WhiteDp[i-1][j-1]);
			}
		}
		System.out.println(min);
	}
}
