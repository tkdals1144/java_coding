package backTracking;
import java.util.*;
import java.io.*;

public class B1987 {
	// y축값 R, x축값 C
	static int R, C;
	static char[][] graph;
	static int[] dx = {-1, 1, 0, 0};
	static int[] dy = {0, 0, -1, 1};
	static ArrayList<Character> saved;
	static int count = 0;
	static void dfs(int[] yx, int depth) {
		if (count < depth) count = depth;
		for (int i = 0; i < 4; i++) {
			int ny = yx[0] + dy[i];
			int nx = yx[1] + dx[i];
			if (0 <= ny && ny < R && 0 <= nx && nx < C) {
				boolean check = false;
				for (char c : saved) {
					if (c == graph[ny][nx]) {
						check = true;
						break;
					}
				}
				if (check) continue;
				dfs(new int[] {ny, nx}, depth+1);
			}
		}
	}
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		StringTokenizer st = new StringTokenizer(br.readLine());
		R = Integer.parseInt(st.nextToken());
		C = Integer.parseInt(st.nextToken());
		graph = new char[R][C];
		saved = new ArrayList<>();
		for (int i = 0; i < R; i++) {
			graph[i] = br.readLine().toCharArray();
		}
		saved.add(graph[0][0]);
		dfs(new int[] {0, 0}, 1);
		System.out.println(count);
	}
}
